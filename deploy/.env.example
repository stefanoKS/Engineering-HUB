# Engineering-HUB V2 deployment environment.
#
# Copy to deploy/.env and fill in. Never commit the filled file. Values marked REQUIRED have no
# safe default: the application refuses to start without them.

# --- database -----------------------------------------------------------------
POSTGRES_USER=ehub
POSTGRES_PASSWORD=REQUIRED-change-me
POSTGRES_DB=engineering_hub
DATABASE_URL=postgresql://ehub:REQUIRED-change-me@db:5432/engineering_hub
PG_POOL_MAX=10

# --- application --------------------------------------------------------------
APP_ENV=PRODUCTION
APP_VERSION=2.0.0
APP_DOMAIN=engineering-hub.example.co.jp
PUBLIC_ORIGIN=https://engineering-hub.example.co.jp
MANAGER_WEB_ALLOWED_DOMAINS=example.co.jp
GOOGLE_CLIENT_ID=REQUIRED-xxxx.apps.googleusercontent.com
SESSION_TTL_MINUTES=720
LOG_LEVEL=info
RATE_LIMIT_MAX=300
BODY_LIMIT_BYTES=262144
# Development only: must stay false in production. The API refuses to start otherwise.
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAILS=
# Comma-separated CIDRs/IPs allowed to set X-Forwarded-For. Never "true" on a host-reachable port.
TRUST_PROXY=172.16.0.0/12

# --- worker / Google Workspace ------------------------------------------------
# Service account JSON (one line). Scopes: gmail.send, calendar.events, drive.file, spreadsheets.
GOOGLE_SERVICE_ACCOUNT_JSON=
GMAIL_SENDER=
CALENDAR_ID=
DRIVE_BACKUP_FOLDER_ID=
BACKUP_ENCRYPTION_KEY=
# Base64 of 32 random bytes: openssl rand -base64 32
BACKUP_RETENTION_DAYS=0
# Hourly is the agreed cadence. The scheduler runs at most one backup per interval.
BACKUP_INTERVAL_MINUTES=60
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
EXPORT_SPREADSHEET_ID=
EXPORT_SHEET_NAME=SNAPSHOT
SCHEDULE_ENABLED=true
WORKER_ID=worker-1
POLL_INTERVAL_MS=5000
LEASE_SECONDS=180

# --- shared dashboard publication destination ---------------------------------
# Never exposed to a browser.
SHARED_DASHBOARD_SNAPSHOT_SPREADSHEET_ID=

# --- optional transition inbox (legacy dashboard during migration) ------------
REQUEST_INBOX_SPREADSHEET_ID=
REQUEST_INBOX_RANGE=REQUESTS!A1:J
REQUEST_INBOX_SERVICE_ACCOUNT=
