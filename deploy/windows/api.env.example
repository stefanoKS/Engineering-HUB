# Copy to data/lan/api.env. Never commit populated credentials.
NODE_ENV=production
APP_ENV=PRODUCTION
AUTH_MODE=local
HOST=0.0.0.0
PORT=8050
PUBLIC_ORIGIN=http://10.1.6.253:8050
# Explicitly accepts unencrypted traffic for a trusted LAN. Prefer HTTPS via a proxy.
ALLOW_INSECURE_LAN_HTTP=true
TRUST_PROXY=false
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAILS=
DATABASE_URL=postgresql://ehub:REPLACE_PASSWORD@127.0.0.1:5432/engineering_hub
WEB_ROOT=apps/web/dist
LOG_LEVEL=info
