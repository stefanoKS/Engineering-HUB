# Copy to data/lan/worker.env. Restrict access to the service account running the host.
NODE_ENV=production
APP_ENV=PRODUCTION
DATABASE_URL=postgresql://ehub:REPLACE_PASSWORD@127.0.0.1:5432/engineering_hub
BACKUP_ONLY=true
BACKUP_DIRECTORY=data/backups
BACKUP_INSTANCE_ID=engineering-hub-office-01
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
PG_DUMP_PATH="C:/Program Files/PostgreSQL/18/bin/pg_dump.exe"
PG_RESTORE_PATH="C:/Program Files/PostgreSQL/18/bin/pg_restore.exe"
SCHEDULE_ENABLED=true
BACKUP_INTERVAL_MINUTES=60
# Google Drive only. Use a Shared Drive folder shared with the service account.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_BACKUP_FOLDER_ID=
# Optional impersonation when approved by Workspace administrator; otherwise blank.
GOOGLE_DRIVE_DELEGATED_USER=
GMAIL_SENDER=
CALENDAR_ID=
EXPORT_SPREADSHEET_ID=
